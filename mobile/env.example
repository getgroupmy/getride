# Copy to `mobile/env` and fill in.
#
# Everything here ships inside the app bundle, so nothing secret belongs in it.
# The Supabase anon key is public by design — what protects the data is RLS
# (migration 0069) and the owner-scoped wallet RPCs (0066), not the key.

# Falls back to the project hardcoded in utils/supabase.ts when unset. That
# fallback means a misconfigured build talks to production rather than failing
# loudly, so set these explicitly for anything that is not production.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maps and routing. Routing tries OSRM first and only falls back to Google, and
# place search uses Nominatim, so search and routing still work without a key —
# reverse geocoding is what degrades.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base URL for the hosted AI toolkit used by document verification, the
# profile-photo check and the TEKSI EV flow.
EXPO_PUBLIC_TOOLKIT_URL=
